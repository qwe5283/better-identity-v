<ui:FluentWindow x:Class="BetterIdentityV.View.Windows.DebugOverlaySettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:windows="clr-namespace:BetterIdentityV.ViewModel.Windows"
                 Title="自定义识别结果显示"
                 Width="480"
                 Height="560"
                 MinWidth="440"
                 MinHeight="360"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 d:DataContext="{d:DesignInstance Type=windows:DebugOverlaySettingsViewModel}"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="自定义识别结果显示">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Images/logo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:TextBlock Grid.Row="1"
                      Margin="24,12,24,16"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="修改即时生效，仅本次运行有效，重启应用后恢复默认。显示内容还需开启“显示图像识别结果”。"
                      TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Margin="24,0,24,0">
            <ui:CardControl Margin="0,0,0,8" Header="自动 QTE 校准">
                <ui:ToggleSwitch Margin="0,0,12,0"
                                 AutomationProperties.Name="自动 QTE 校准"
                                 IsChecked="{Binding IsAutoQteVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
            <ui:CardControl Header="弓箭准心吸附">
                <ui:ToggleSwitch Margin="0,0,12,0"
                                 AutomationProperties.Name="弓箭准心吸附"
                                 IsChecked="{Binding IsAutoTargetVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
        </StackPanel>

        <ui:Button Grid.Row="3"
                   Width="80"
                   Margin="24,16,24,24"
                   HorizontalAlignment="Right"
                   Content="关闭"
                   IsCancel="True" />
    </Grid>
</ui:FluentWindow>
